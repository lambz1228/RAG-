# 生物领域知识库；复制为 .env 后修改，真实 .env 不加入版本控制。
BIOKB_DATA_DIR=data/biokb
BIOKB_HOST=127.0.0.1
BIOKB_PORT=5000
BIOKB_CHUNK_SIZE=800
BIOKB_CHUNK_OVERLAP=120
BIOKB_RETRIEVAL=hybrid
BIOKB_TOP_K=5
BIOKB_WORKERS=2
BIOKB_REQUEST_TIMEOUT=60
BIOKB_MAX_CONTEXT_CHARS=24000

# hash 是离线功能基线；正式语义实验可选 ollama 或 openai_compatible。
BIOKB_EMBEDDING_BACKEND=hash
BIOKB_EMBEDDING_MODEL=local-hash-v2
BIOKB_EMBEDDING_DIMENSIONS=384
BIOKB_EMBEDDING_BASE_URL=http://127.0.0.1:11434
BIOKB_EMBEDDING_API_KEY=
# 可填写已有系统环境变量名称，密钥本身无需复制到此文件。
BIOKB_EMBEDDING_API_KEY_ENV=
BIOKB_EMBEDDING_REVISION=

# disabled 显示原文；启用模型时填写实际部署的模型名称。
BIOKB_LLM_BACKEND=disabled
BIOKB_LLM_MODEL=
BIOKB_LLM_BASE_URL=http://127.0.0.1:11434
BIOKB_LLM_API_KEY=
BIOKB_LLM_API_KEY_ENV=
# 兼容服务确认支持 JSON mode 后可选 json_object；默认不要求该能力。
BIOKB_LLM_RESPONSE_FORMAT=text

BIOKB_RETRIEVAL_CANDIDATES=50
BIOKB_RRF_CONSTANT=60
BIOKB_DENSE_MIN_SCORE=0.12
BIOKB_MAX_EVIDENCE_PER_DOCUMENT=2

# compatible 使用 /rerank 协议；disabled 时不调用重排序服务。
BIOKB_RERANKER_BACKEND=disabled
BIOKB_RERANKER_MODEL=
BIOKB_RERANKER_BASE_URL=http://127.0.0.1:11434
BIOKB_RERANKER_API_KEY=
BIOKB_RERANKER_API_KEY_ENV=

# 对外监听必须设置访问令牌；本机单用户演示可留空。
BIOKB_API_TOKEN=
