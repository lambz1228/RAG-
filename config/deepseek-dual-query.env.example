# DeepSeek 官方回答生成接口；密钥仅引用系统变量，不写入文件。
BIOKB_LLM_BACKEND=openai_compatible
BIOKB_LLM_MODEL=deepseek-flash
BIOKB_LLM_BASE_URL=https://api.deepseek.com
BIOKB_LLM_API_KEY_ENV=ds_key
BIOKB_LLM_RESPONSE_FORMAT=json_object
BIOKB_LLM_OUTPUT_MODE=answer
BIOKB_LLM_MAX_TOKENS=4096
BIOKB_REQUEST_TIMEOUT=180

# 本机真实语义索引；模型及数据库不随源码分发。
BIOKB_DATA_DIR=data/local-20261116/semantic
BIOKB_EMBEDDING_BACKEND=onnx_e5
BIOKB_EMBEDDING_MODEL=intfloat/multilingual-e5-small
BIOKB_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
BIOKB_EMBEDDING_MODEL_PATH=data/models/multilingual-e5-small
BIOKB_EMBEDDING_THREADS=2
BIOKB_EMBEDDING_DIMENSIONS=384
BIOKB_QUERY_TERM_EXPANSION=true
BIOKB_RETRIEVAL=hybrid
BIOKB_TOP_K=5
BIOKB_MAX_CONTEXT_CHARS=6000

# 每个未缓存中文问题增加一次英文转换调用；失败时保留原查询。
BIOKB_QUERY_TRANSLATION=true
