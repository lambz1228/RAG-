# 任务书开发实验示例：本机 llama.cpp 服务，不含任何密钥。
# 先启动模型服务；不要覆盖已有 .env 或已有数据库。
BIOKB_DATA_DIR=data/taskbook-semantic
BIOKB_HOST=127.0.0.1
BIOKB_PORT=5000
BIOKB_EMBEDDING_BACKEND=openai_compatible
BIOKB_EMBEDDING_MODEL=biokb-qwen3-embedding-0.6b
BIOKB_EMBEDDING_BASE_URL=http://127.0.0.1:18081/v1
BIOKB_EMBEDDING_DIMENSIONS=1024
BIOKB_EMBEDDING_REVISION=Qwen3-Embedding-0.6B-Q8_0@370f27d7550e0def9b39c1f16d3fbaa13aa67728
BIOKB_LLM_BACKEND=openai_compatible
BIOKB_LLM_MODEL=biokb-qwen2.5-1.5b
BIOKB_LLM_BASE_URL=http://127.0.0.1:18080/v1
BIOKB_LLM_RESPONSE_FORMAT=json_schema
BIOKB_LLM_OUTPUT_MODE=claims
BIOKB_RERANKER_BACKEND=disabled
BIOKB_RETRIEVAL=hybrid
BIOKB_TOP_K=5
BIOKB_REQUEST_TIMEOUT=300
BIOKB_MAX_CONTEXT_CHARS=6000
BIOKB_LLM_MAX_TOKENS=512
